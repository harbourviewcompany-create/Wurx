# ---------------------------------------------------------------------------
# Next.js app (set these in Vercel → Project → Settings → Environment Variables,
# and in .env.local for local development)
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://rzdavbuoisckvdapbcbj.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable / anon key (safe to expose to the browser; RLS enforces access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute origin of the deployed site (used for auth redirect URLs)
NEXT_PUBLIC_SITE_URL=https://wurx.vercel.app

# Stripe *publishable* key (pk_test_... / pk_live_...), used by the embedded
# Connect payout onboarding. Never put the secret key in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Supabase Edge Functions (set with: supabase secrets set KEY=value)
# These are NOT used by the Next.js app and must never be exposed to the browser.
# ---------------------------------------------------------------------------

# STRIPE_SECRET_KEY=sk_live_or_test_...
# STRIPE_WEBHOOK_SIGNING_SECRET=whsec_...
# SITE_URL=https://wurx.vercel.app
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected into functions automatically.
